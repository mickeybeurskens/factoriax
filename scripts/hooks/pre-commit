#!/usr/bin/env bash
# Pre-commit hook: runs linting and tests before allowing a commit.

set -e

# Only lint staged Python files.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [ -n "$STAGED" ]; then
    echo "[pre-commit] Running ruff check on staged files..."
    uv run ruff check $STAGED

    echo "[pre-commit] Running ruff format check on staged files..."
    uv run ruff format --check $STAGED
fi

# Skip tests unless a staged file could actually change their outcome
TEST_RELEVANT=$(
    git diff --cached --name-only --diff-filter=ACMR \
        | grep -E '^(factoriax/|tests/|pyproject\.toml$|uv\.lock$)' \
        || true
)

if [ -z "$TEST_RELEVANT" ]; then
    echo "[pre-commit] No staged changes under factoriax/, tests/"
    echo "[pre-commit] skipping pytest."
else
    echo "[pre-commit] Running tests."
    # The fail-under floor lives in pyproject.toml's
    uv run pytest tests/ -x \
        --cov --cov-report=term:skip-covered
fi

echo "[pre-commit] All checks passed."
