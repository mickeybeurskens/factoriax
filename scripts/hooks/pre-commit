#!/usr/bin/env bash
# Pre-commit hook: runs linting and tests before allowing a commit.
# Install with: make install-hooks

set -e

# Only lint staged Python files.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')

if [ -n "$STAGED" ]; then
    echo "[pre-commit] Running ruff check on staged files..."
    uv run ruff check $STAGED

    echo "[pre-commit] Running ruff format check on staged files..."
    uv run ruff format --check $STAGED
fi

echo "[pre-commit] Running fast tests (skipping @pytest.mark.slow)..."
echo "[pre-commit] The full suite — including JIT-heavy integration"
echo "[pre-commit] tests (invariants, smoke, benchmarks, debugger) — runs in CI."
uv run pytest tests/ -x -q -m "not slow"

echo "[pre-commit] All checks passed."
