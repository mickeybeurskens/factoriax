#!/usr/bin/env bash
# Pre-push hook: runs the full no-cov test suite and fails the push
# if wall time exceeds the regression threshold.
#
# Goal: protect the gains landed in Phase 2 of SPEC_TEST_SUITE.md
# (which dropped the full suite from ~766s to ~396s) from silent
# regressions. Push-time rather than commit-time so the dev loop
# stays fast — only one suite run per push, not one per commit.
#
# Install with: make install-hooks
#
# Skips when:
# - FACTORIAX_SKIP_PRE_PUSH=1 (developer override)
# - non-interactive contexts (CI, etc. — but CI has its own
#   regression check so this isn't load-bearing there)
# - no factoriax/, tests/, or pyproject.toml changes in the push
#   range (nothing to regress on)

set -e

# --- Escape hatches ---------------------------------------------------------

if [ "${FACTORIAX_SKIP_PRE_PUSH:-}" = "1" ]; then
    echo "[pre-push] FACTORIAX_SKIP_PRE_PUSH=1 set; skipping suite."
    exit 0
fi

# --- Relevance check --------------------------------------------------------
#
# Git sends "<local-ref> <local-sha> <remote-ref> <remote-sha>" lines on
# stdin for each ref being pushed. We collect the SHA ranges and check
# whether any changed file under factoriax/, tests/, pyproject.toml, or
# uv.lock — i.e. anything that could plausibly affect test wall time.
#
# If git can't determine a range (e.g. a brand-new remote ref), we err
# on the side of running the suite.

CHANGED=""
while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [ -z "${LOCAL_SHA}" ] || [ "${LOCAL_SHA}" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi
    if [ -z "${REMOTE_SHA}" ] || [ "${REMOTE_SHA}" = "0000000000000000000000000000000000000000" ]; then
        # Pushing a new branch — diff against HEAD's first parent merge base
        # would work, but we just punt and assume the worst.
        CHANGED="all"
        break
    fi
    RANGE_FILES=$(git diff --name-only "${REMOTE_SHA}..${LOCAL_SHA}" 2>/dev/null \
        | grep -E '^(factoriax/|tests/|pyproject\.toml$|uv\.lock$)' || true)
    if [ -n "${RANGE_FILES}" ]; then
        CHANGED="yes"
    fi
done

if [ -z "${CHANGED}" ]; then
    echo "[pre-push] No factoriax/, tests/, or dependency-manifest changes"
    echo "[pre-push] in the push range; skipping suite."
    exit 0
fi

# --- Threshold --------------------------------------------------------------
#
# 450s = ~14% above the post-Phase-2 wall time of ~395s. Run-to-run
# variance has been ~5-7% in measurements; the extra headroom catches
# real regressions while tolerating warm-cache and AC-vs-battery noise.
# Raise this number when the suite genuinely speeds up; don't lower it
# without a recorded reason in SPEC_TEST_SUITE.md.

THRESHOLD_SECONDS=450

# --- Run --------------------------------------------------------------------

# Keep the SSH connection to the remote alive during the long suite
# run — GitHub's sshd otherwise idle-times out after ~5 min and the
# subsequent push fails with "Connection closed by remote host" even
# though every check passes. Setting these here only affects the
# child process inheriting the env (git's push), not unrelated shells.
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o ServerAliveInterval=60 -o ServerAliveCountMax=10}"

echo "[pre-push] Running full no-cov test suite (threshold ${THRESHOLD_SECONDS}s)..."
START_NS=$(date +%s%N)
if ! uv run pytest --no-cov -q; then
    echo "[pre-push] Suite failed. Push aborted."
    exit 1
fi
END_NS=$(date +%s%N)

ELAPSED_S=$(( (END_NS - START_NS) / 1000000000 ))
echo "[pre-push] Suite completed in ${ELAPSED_S}s (threshold ${THRESHOLD_SECONDS}s)."

if [ "${ELAPSED_S}" -gt "${THRESHOLD_SECONDS}" ]; then
    cat <<EOF
[pre-push] Wall-time threshold exceeded: ${ELAPSED_S}s > ${THRESHOLD_SECONDS}s.
[pre-push] The full suite has regressed.  See SPEC_TEST_SUITE.md
[pre-push] "Phase 2 Results" for context on the threshold and the
[pre-push] Phase 2 work that established the floor.
[pre-push]
[pre-push] If this is a one-off (warm-up, thermal throttling, etc.),
[pre-push] re-run the push. Set FACTORIAX_SKIP_PRE_PUSH=1 to bypass
[pre-push] permanently for the current push command.
EOF
    exit 1
fi

echo "[pre-push] All checks passed."
exit 0
