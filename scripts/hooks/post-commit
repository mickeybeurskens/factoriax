#!/usr/bin/env bash
# Post-commit hook: offers to run the performance benchmark and log it
# to wandb (project "factoriax-benchmarks"). Only triggers when the
# commit actually touched engine code under factoriax/ — commits that
# only edit scripts/, baselines/, docs/, tests/, paper/, or top-level
# text have no engine-perf impact. Install with: make install-hooks.
#
# Skips in non-interactive contexts (CI, rebase, amend, etc.).
# Set FACTORIAX_SKIP_PERF=1 to suppress the prompt ad hoc.

if [ ! -t 0 ]; then
    exit 0
fi
if [ "${FACTORIAX_SKIP_PERF:-}" = "1" ]; then
    exit 0
fi

# Engine-relevant iff HEAD^..HEAD touched factoriax/.
ENGINE_TOUCHED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null \
    | grep -E '^factoriax/' || true)

if [ -z "${ENGINE_TOUCHED}" ]; then
    exit 0
fi

echo ""
echo "[post-commit] Engine code changed. Please run the perf benchmark:"
echo "[post-commit]   - Continuous throughput history in wandb is what"
echo "[post-commit]     makes perf regressions VISIBLE between commits."
echo "[post-commit]   - Each skipped run is a gap; the trend line breaks."
echo "[post-commit]   - ~2-3 min on a warm GPU; runs fully in background"
echo "[post-commit]     if you say no now and queue it with the command"
echo "[post-commit]     printed at the bottom."
echo ""
printf "[post-commit] Run perf benchmark now? [Y/n] "
read -r answer </dev/tty

case "${answer}" in
    n|N|no|NO)
        echo "[post-commit] Skipped. Queue it later with:"
        echo "              uv run python scripts/post_commit_perf.py"
        ;;
    *)
        uv run python scripts/post_commit_perf.py
        ;;
esac

exit 0
